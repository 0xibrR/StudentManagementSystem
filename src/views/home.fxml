<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.HomeController"
            prefWidth="1120" prefHeight="760"
            styleClass="app-root" stylesheets="@../css/style.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="page-header">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Student Management System" styleClass="page-title"/>
                <Label fx:id="lblWelcome" styleClass="page-subtitle"/>
            </VBox>
            <Label text="STUDENT PORTAL" style="-fx-text-fill:#718096; -fx-font-size:11px; -fx-font-weight:bold;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14" styleClass="content-area">
            <HBox spacing="12" styleClass="dashboard-cards">
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Students" styleClass="metric-label"/>
                    <Label fx:id="lblTotalStudents" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Payments" styleClass="metric-label"/>
                    <Label fx:id="lblTotalPayments" text="0" styleClass="metric-value"/>
                </VBox>
                <VBox fx:id="remainingCard" alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Remaining" styleClass="metric-label"/>
                    <Label fx:id="lblRemaining" text="0.00 ₪" styleClass="metric-value"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Cash" styleClass="metric-label"/>
                    <Label fx:id="lblCashIncome" text="0.00 ₪" styleClass="metric-value"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Bank" styleClass="metric-label"/>
                    <Label fx:id="lblBankIncome" text="0.00 ₪" styleClass="metric-value"/>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="6" styleClass="metric-card" HBox.hgrow="ALWAYS">
                    <Label text="Total Income" styleClass="metric-label"/>
                    <Label fx:id="lblTotalIncome" text="0.00 ₪" styleClass="metric-value"/>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-bar">
                <Label text="Search students" styleClass="section-title"/>
                <TextField fx:id="txtSearch" promptText="Search by name, phone, or birth year..." HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="cmbBirthYearFilter" promptText="Birth year" prefWidth="135"/>
                <Label fx:id="lblStudentResults" styleClass="page-subtitle"/>
            </HBox>
            <TableView fx:id="tableStudents" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="65"/>
                    <TableColumn fx:id="colName" text="Student Name" prefWidth="190"/>
                    <TableColumn fx:id="colYear" text="Birth Year" prefWidth="105"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="150"/>
                    <TableColumn fx:id="colEnrollmentDate" text="Registration Date" prefWidth="165"/>
                    <TableColumn fx:id="colNotes" text="Notes" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="action-bar">
            <Button text="Add Student" styleClass="primary-button" onAction="#handleAdd"/>
            <Button text="Payment History" onAction="#handlePayments"/>
            <Button text="Attendance" styleClass="primary-button" onAction="#handleAttendance"/>
            <Button text="Edit" onAction="#handleEdit"/>
            <Button text="Delete" styleClass="danger-button" onAction="#handleDelete"/>
            <MenuButton text="Reports">
                <items>
                    <MenuItem text="Students Report" onAction="#handleExportStudentsReport"/>
                    <MenuItem text="Students CSV" onAction="#handleExportStudentsCsv"/>
                    <MenuItem text="Payments Report" onAction="#handleExportPaymentsReport"/>
                    <MenuItem text="Payments CSV" onAction="#handleExportPaymentsCsv"/>
                </items>
            </MenuButton>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
            <Button text="Logout" onAction="#handleLogout"/>
        </HBox>
    </bottom>
</BorderPane>
