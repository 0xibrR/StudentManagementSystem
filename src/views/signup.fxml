<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="controllers.SignUpController"
           prefWidth="430" prefHeight="490"
           styleClass="app-root" stylesheets="@../css/style.css">
    <VBox alignment="CENTER" spacing="14" maxWidth="350" maxHeight="460" styleClass="auth-form">
        <Label text="Create your account" styleClass="page-title"/>
        <Label text="Set up your student management workspace" styleClass="page-subtitle"/>
        <HBox spacing="28" alignment="CENTER" style="-fx-padding:6 0 2 0;">
            <Label text="SIGN IN" styleClass="link-label" onMouseClicked="#goToLogin"/>
            <Label text="SIGN UP" style="-fx-text-fill:#2864b4; -fx-font-weight:bold; -fx-underline:true;"/>
        </HBox>
        <TextField fx:id="txtFullName" promptText="Full name" styleClass="input-field" maxWidth="Infinity"/>
        <TextField fx:id="txtUsername" promptText="Username" styleClass="input-field" maxWidth="Infinity"/>
        <PasswordField fx:id="txtPassword" promptText="Password" styleClass="input-field" maxWidth="Infinity"/>
        <PasswordField fx:id="txtConfirmPassword" promptText="Confirm password" styleClass="input-field" maxWidth="Infinity"/>
        <Button text="CREATE ACCOUNT" styleClass="primary-button" onAction="#handleSignUp" maxWidth="Infinity"/>
        <Label text="Already have an account? Sign in" styleClass="link-label" onMouseClicked="#goToLogin"/>
    </VBox>
</StackPane>
