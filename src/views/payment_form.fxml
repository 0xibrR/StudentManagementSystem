<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.PaymentController"
            prefWidth="520" prefHeight="630"
            styleClass="app-root" stylesheets="@../css/style.css">
    <top>
        <VBox spacing="4" styleClass="page-header">
            <Label text="Student payment" styleClass="page-title"/>
            <Label text="Record a payment and review the remaining balance." styleClass="page-subtitle"/>
        </VBox>
    </top>
    <center>
        <GridPane alignment="CENTER" hgap="16" vgap="12" style="-fx-padding:20 32;">
            <columnConstraints>
                <ColumnConstraints minWidth="145"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="240"/>
            </columnConstraints>
            <Label text="Student" styleClass="metric-label"/>
            <Label fx:id="lblStudent" styleClass="section-title" GridPane.columnIndex="1"/>
            <Label text="Payment method" styleClass="metric-label" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbMethod" prefWidth="200" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="Cash amount" styleClass="metric-label" GridPane.rowIndex="2"/>
            <TextField fx:id="txtCash" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="Bank amount" styleClass="metric-label" GridPane.rowIndex="3"/>
            <TextField fx:id="txtBank" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="Amount due" styleClass="metric-label" GridPane.rowIndex="4"/>
            <TextField fx:id="txtAmountDue" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <Label text="Paid" styleClass="metric-label" GridPane.rowIndex="5"/>
            <TextField fx:id="txtPaid" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            <Label text="Remaining" styleClass="metric-label" GridPane.rowIndex="6"/>
            <TextField fx:id="txtRemaining" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            <Label text="Notes" styleClass="metric-label" GridPane.rowIndex="7"/>
            <TextArea fx:id="txtNotes" promptText="Optional notes" prefRowCount="4" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
        </GridPane>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="action-bar">
            <Button text="Cancel" onAction="#handleCancel"/>
            <Button text="Save payment" styleClass="primary-button" onAction="#handleSave"/>
        </HBox>
    </bottom>
</BorderPane>
